FROM python:3.11-slim

ENV POETRY_VIRTUALENVS_IN_PROJECT=true \
    POETRY_VIRTUALENVS_CREATE=true

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    wget \
    unzip \
    curl \
    gcc \
    libpq-dev \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Install OpenStack CLI
RUN pip install --no-cache-dir python-openstackclient

ARG TARGETARCH
ARG TOFU_VERSION=1.13.2
ARG TOFU_SHA256_AMD64=723bebb0df8411daff1e5fc3862e28ff5581fe5634087f4c29a9aa41d78208b5
ARG TOFU_SHA256_ARM64=6e815c58a09ee957de606ff48cefad082942e70afc43b737ff975654c54ec453
# Install OpenTofu (platform-aware). Gleiche Version und Summen wie im
# Produktions-Dockerfile — dort steht, warum die Summen fest verdrahtet sind.
# Bei einem Versionswechsel beide Dateien gemeinsam anheben.
RUN ARCH="${TARGETARCH:-amd64}" && \
    case "$ARCH" in \
      amd64) SHA="$TOFU_SHA256_AMD64" ;; \
      arm64) SHA="$TOFU_SHA256_ARM64" ;; \
      *) echo "Unsupported arch: $ARCH" >&2; exit 1 ;; \
    esac && \
    wget -q https://github.com/opentofu/opentofu/releases/download/v${TOFU_VERSION}/tofu_${TOFU_VERSION}_linux_${ARCH}.zip && \
    echo "${SHA}  tofu_${TOFU_VERSION}_linux_${ARCH}.zip" | sha256sum -c - && \
    unzip -qo tofu_${TOFU_VERSION}_linux_${ARCH}.zip tofu && \
    mv tofu /usr/local/bin/ && \
    rm -f tofu_${TOFU_VERSION}_linux_${ARCH}.zip && \
    tofu version

# Install Poetry
RUN curl -sSL https://install.python-poetry.org | python3 - && \
    ln -s /root/.local/bin/poetry /usr/local/bin/poetry

# Copy Poetry files and install dependencies
COPY pyproject.toml poetry.lock ./
RUN poetry install --no-root --no-interaction --no-ansi

# Copy application code
COPY . .

# Create temp directory for repositories
RUN mkdir -p /tmp/worker_repos

# Starte Celery Worker mit poetry run
CMD ["poetry", "run", "celery", "-A", "app.celery_app", "worker", "--loglevel=info", "--autoscale=2,20", "-E", "--prefetch-multiplier=1"]
